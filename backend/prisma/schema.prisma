generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    // Bcrypt hash
  firstName     String
  lastName      String
  role          Role      @default(DOCTOR)
  isActive      Boolean   @default(true)
  
  // Security fields
  lastLoginAt       DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil       DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  profile       DoctorProfile?
}

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Datos Profesionales (Obligatorios para Recetas Médicas)
  specialty       String   // Ej. Pediatría, Medicina General
  licenseNumber   String   // Cédula Profesional (Crucial para validez legal)
  specialtyLicense String? // Cédula de Especialidad (Opcional)
  university      String?  // Universidad que expidió el título (Requerido en algunos países)
  
  // Datos del Consultorio/Clínica
  clinicName      String   // Nombre del consultorio o clínica
  clinicAddress   String   // Dirección física
  phoneNumber     String   // Teléfono de contacto
  
  // Personalización
  logoUrl         String?  // URL del logo para imprimir en la receta
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Role {
  ADMIN
  DOCTOR
  ASSISTANT
}
