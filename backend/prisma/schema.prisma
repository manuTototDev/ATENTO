generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    // Bcrypt hash
  firstName     String
  lastName      String
  role          Role      @default(DOCTOR)
  isActive      Boolean   @default(true)
  
  // Security fields
  lastLoginAt       DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil       DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  profile       DoctorProfile?
  patients      Patient[]
  consultations Consultation[] @relation("DoctorConsultations")
  appointments  Appointment[]
  inventory     InventoryItem[]
}

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Datos Profesionales (Obligatorios para Recetas Médicas)
  specialtyId     String?
  specialty       Specialty? @relation(fields: [specialtyId], references: [id])
  licenseNumber   String   // Cédula Profesional (Crucial para validez legal)
  specialtyLicense String? // Cédula de Especialidad (Opcional)
  universityId    String?
  university      University? @relation(fields: [universityId], references: [id])
  
  // Datos del Consultorio/Clínica
  clinicName      String   // Nombre del consultorio o clínica
  clinicAddress   String   // Dirección física
  phoneNumber     String   // Teléfono de contacto
  
  // Personalización
  logoUrl         String?  // URL del logo para imprimir en la receta
  
  // Tabulador de Precios
  basePrice       Float    @default(800)
  nightPrice      Float    @default(1200)
  nightTime       String   @default("20:00")
  saturdayPrice   Float    @default(1000)
  sundayPrice     Float    @default(1500)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Specialty {
  id              String          @id @default(uuid())
  name            String          @unique
  isActive        Boolean         @default(true)
  profiles        DoctorProfile[]
}

model University {
  id              String          @id @default(uuid())
  name            String          @unique
  isActive        Boolean         @default(true)
  profiles        DoctorProfile[]
}

model Allergy {
  id              String          @id @default(uuid())
  name            String          @unique
  isActive        Boolean         @default(true)
}

model Patient {
  id              String         @id @default(uuid())
  doctorId        String         // El doctor que registró o atiende a este paciente
  doctor          User           @relation(fields: [doctorId], references: [id])
  
  firstName       String
  lastName        String
  dateOfBirth     DateTime
  gender          String         // M, F, Otro
  phone           String?
  email           String?
  
  // Expediente (Guardados como arreglos de strings para análisis de datos / tokens)
  bloodType          String?
  allergies          String[]       @default([])
  chronicDiseases    String[]       @default([])
  currentTreatments  String[]       @default([])
  
  consultations   Consultation[]
  appointments    Appointment[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Consultation {
  id              String         @id @default(uuid())
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          User           @relation("DoctorConsultations", fields: [doctorId], references: [id])
  
  // Notas SOAP (Estructura médica estándar)
  subjective      String?        @db.Text // Síntomas, motivo de consulta
  objective       String?        @db.Text // Exploración física, signos vitales
  assessment      String?        @db.Text // Diagnóstico
  icd10Code       String?        // Código CIE-10 (ICD-10) internacional
  plan            String?        @db.Text // Tratamiento, Receta
  
  // Cobro
  cost            Float          @default(0)
  hasVariableCost Boolean        @default(false) // Si se aplicó tarifa nocturna o fin de semana
  
  // Transcripción Original y Audio
  rawTranscription Json?          // Guardamos la transcripción completa original sin alterar (texto y metadatos)
  audio            ConsultationAudio?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ConsultationAudio {
  id              String         @id @default(uuid())
  consultationId  String         @unique
  consultation    Consultation   @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  audioBase64     String         @db.Text // ¡Cuidado! Puede crecer rápido. A futuro migrar a S3/Supabase Storage.
  createdAt       DateTime       @default(now())
}

model Appointment {
  id              String         @id @default(uuid())
  doctorId        String
  doctor          User           @relation(fields: [doctorId], references: [id])
  patientId       String?        // Opcional por si agenda alguien no registrado aún
  patient         Patient?       @relation(fields: [patientId], references: [id])
  
  patientName     String?        // Útil si patientId es nulo
  reason          String?
  startTime       DateTime
  endTime         DateTime
  status          String         @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model InventoryItem {
  id              String         @id @default(uuid())
  doctorId        String
  doctor          User           @relation(fields: [doctorId], references: [id])
  
  name            String
  description     String?
  stock           Int            @default(0)
  price           Float          @default(0)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum Role {
  ADMIN
  DOCTOR
  ASSISTANT
}

model Medication {
  id              String   @id @default(uuid())
  name            String   // Nombre comercial o genérico
  activePrinciple String?  // Principio activo
  presentation    String?  // Presentación (ej. Tabletas 500mg)
  
  // Para futuras referencias de COFEPRIS
  registrationNo  String?  // Registro Sanitario COFEPRIS
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==============================================================
// DATA LAKE / ANALYTICS (TABLAS ANONIMIZADAS SIN PII)
// ==============================================================

model AnalyticsPatient {
  id              String   @id @default(uuid())
  doctorId        String
  ageAtInsertion  Int
  gender          String?
  bloodType       String?
  allergies       String[]
  chronicDiseases String[]
  
  analyticsConsultations AnalyticsConsultation[]

  createdAt       DateTime @default(now())
}

model AnalyticsConsultation {
  id                 String   @id @default(uuid())
  analyticsPatientId String
  patient            AnalyticsPatient @relation(fields: [analyticsPatientId], references: [id])
  
  doctorId           String
  diagnoses          String?  // Derivado del assessment del SOAP
  icd10Code          String?  // Estandarización Internacional CIE-10
  treatmentsCount    Int
  cost               Float
  hasVariableCost    Boolean
  dayOfWeek          Int
  hourOfDay          Int
  
  analyticsPrescriptions AnalyticsPrescription[]

  createdAt          DateTime @default(now())
}

model AnalyticsPrescription {
  id                    String   @id @default(uuid())
  analyticsConsultationId String
  consultation          AnalyticsConsultation @relation(fields: [analyticsConsultationId], references: [id])
  
  activePrinciple       String   // Ej: Paracetamol
  medicationName        String   // Ej: Tylenol
  dose                  String
  durationDays          Int?
  
  createdAt             DateTime @default(now())
}
